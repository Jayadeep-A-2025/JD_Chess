"""PySide6 graphical interface for the chess application."""

import chess

from PySide6.QtCore import Qt
from PySide6.QtWidgets import (
    QApplication,
    QGridLayout,
    QHBoxLayout,
    QLabel,
    QMainWindow,
    QMessageBox,
    QPushButton,
    QSizePolicy,
    QVBoxLayout,
    QWidget,
)

from app.core.chess_game import ChessGame


# Unicode chess glyphs. White pieces use outline-style symbols;
# black pieces use filled symbols.
PIECE_GLYPHS = {
    "K": "♔",
    "Q": "♕",
    "R": "♖",
    "B": "♗",
    "N": "♘",
    "P": "♙",
    "k": "♚",
    "q": "♛",
    "r": "♜",
    "b": "♝",
    "n": "♞",
    "p": "♟",
}


class ChessBoardWidget(QWidget):
    """Clickable chessboard, displayed with Black at the bottom."""

    def __init__(self, game: ChessGame, parent=None):
        super().__init__(parent)
        self.game = game
        self.selected_square = None
        self.legal_destinations = set()
        self.square_buttons = {}

        self.board_layout = QGridLayout(self)
        self.board_layout.setSpacing(0)
        self.board_layout.setContentsMargins(0, 0, 0, 0)

        for row in range(8):
            for col in range(8):
                button = QPushButton()
                button.setMinimumSize(48, 48)
                button.setSizePolicy(
                    QSizePolicy.Policy.Expanding,
                    QSizePolicy.Policy.Expanding,
                )
                button.setFocusPolicy(Qt.FocusPolicy.NoFocus)

                button.clicked.connect(
                    lambda checked=False, r=row, c=col:
                    self.handle_square_click(r, c)
                )

                self.square_buttons[(row, col)] = button
                self.board_layout.addWidget(button, row, col)

        self.setMinimumSize(384, 384)
        self.refresh()

    def visual_to_square(self, row: int, col: int) -> int:
        """Convert a screen position to a chess square.

        The board is rotated 180 degrees so Black starts at the bottom.
        """
        file_index = 7 - col
        rank_index = row
        return chess.square(file_index, rank_index)

    def handle_square_click(self, row: int, col: int) -> None:
        """Select a piece, move it, or change the selection."""
        square = self.visual_to_square(row, col)
        piece = self.game.board.piece_at(square)

        if self.selected_square is not None:
            uci_move = (
                chess.square_name(self.selected_square)
                + chess.square_name(square)
            )

            # Promote pawns to queens automatically in this first version.
            selected_piece = self.game.board.piece_at(self.selected_square)
            if (
                selected_piece is not None
                and selected_piece.piece_type == chess.PAWN
                and chess.square_rank(square) in (0, 7)
            ):
                uci_move += "q"

            try:
                if uci_move in {
                    move.uci() for move in self.game.board.legal_moves
                }:
                    self.game.make_move(uci_move)
                    self.selected_square = None
                    self.legal_destinations.clear()
                    self.refresh()
                    self.parent_window().update_game_info()
                    return
            except ValueError:
                pass

        if piece is not None and piece.color == self.game.board.turn:
            self.selected_square = square
            self.legal_destinations = set(
                self.game.get_legal_moves(chess.square_name(square))
            )
        else:
            self.selected_square = None
            self.legal_destinations.clear()

        self.refresh()

    def parent_window(self):
        """Return the main window that owns this board."""
        return self.window()

    def refresh(self) -> None:
        """Redraw all pieces and selection highlights."""
        for (row, col), button in self.square_buttons.items():
            square = self.visual_to_square(row, col)
            square_name = chess.square_name(square)
            piece = self.game.board.piece_at(square)

            is_light = (row + col) % 2 == 0
            background = "#F0F1F3" if is_light else "#AEB4BD"
            foreground = "#20242B"

            if square == self.selected_square:
                background = "#E8D477"
            elif square_name in self.legal_destinations:
                background = "#B9D8BD"

            glyph = PIECE_GLYPHS.get(piece.symbol(), "") if piece else ""
            button.setText(glyph)

            button.setStyleSheet(
                f"""
                QPushButton {{
                    background-color: {background};
                    color: {foreground};
                    border: none;
                    border-radius: 0px;
                    font-size: 38px;
                    font-weight: normal;
                    padding: 0px;
                }}
                QPushButton:hover {{
                    border: 2px solid #667085;
                }}
                """
            )


class MainWindow(QMainWindow):
    """Main application window."""

    def __init__(self):
        super().__init__()
        self.setWindowTitle("JD Chess")
        self.resize(900, 650)
        self.game = ChessGame()

        central = QWidget()
        self.setCentralWidget(central)

        root_layout = QHBoxLayout(central)
        root_layout.setContentsMargins(20, 20, 20, 20)
        root_layout.setSpacing(24)

        # Left side: chessboard.
        self.board_widget = ChessBoardWidget(self.game)
        root_layout.addWidget(self.board_widget, 3)

        # Right side: status, controls, and move history.
        side_panel = QWidget()
        side_panel.setMinimumWidth(220)
        side_layout = QVBoxLayout(side_panel)
        side_layout.setContentsMargins(0, 0, 0, 0)
        side_layout.setSpacing(12)

        title = QLabel("JD CHESS")
        title.setStyleSheet(
            "font-size: 26px; font-weight: 700; color: #20242B;"
        )
        side_layout.addWidget(title)

        self.turn_label = QLabel()
        self.turn_label.setStyleSheet(
            "font-size: 17px; font-weight: 600; color: #303640;"
        )
        side_layout.addWidget(self.turn_label)

        self.status_label = QLabel()
        self.status_label.setWordWrap(True)
        self.status_label.setStyleSheet(
            "font-size: 13px; color: #5E6672;"
        )
        side_layout.addWidget(self.status_label)

        self.new_game_button = QPushButton("New Game")
        self.undo_button = QPushButton("Undo Move")

        for button in (self.new_game_button, self.undo_button):
            button.setMinimumHeight(40)
            button.setCursor(Qt.CursorShape.PointingHandCursor)
            button.setStyleSheet(
                """
                QPushButton {
                    background-color: #E5E7EB;
                    color: #20242B;
                    border: 1px solid #D1D5DB;
                    border-radius: 8px;
                    padding: 8px 12px;
                    font-size: 14px;
                    font-weight: 600;
                }
                QPushButton:hover {
                    background-color: #D8DCE2;
                }
                QPushButton:pressed {
                    background-color: #C8CDD5;
                }
                """
            )

        self.new_game_button.clicked.connect(self.start_new_game)
        self.undo_button.clicked.connect(self.undo_move)

        side_layout.addWidget(self.new_game_button)
        side_layout.addWidget(self.undo_button)

        moves_title = QLabel("MOVE HISTORY")
        moves_title.setStyleSheet(
            "font-size: 12px; font-weight: 700; color: #777F8A;"
        )
        side_layout.addWidget(moves_title)

        self.moves_label = QLabel("No moves yet")
        self.moves_label.setWordWrap(True)
        self.moves_label.setAlignment(
            Qt.AlignmentFlag.AlignTop | Qt.AlignmentFlag.AlignLeft
        )
        self.moves_label.setStyleSheet(
            """
            QLabel {
                background-color: #F3F4F6;
                color: #303640;
                border-radius: 8px;
                padding: 12px;
                font-size: 14px;
            }
            """
        )
        side_layout.addWidget(self.moves_label, 1)

        root_layout.addWidget(side_panel, 1)

        self.setStyleSheet("QMainWindow { background-color: #FAFAFB; }")
        self.update_game_info()

    def update_game_info(self) -> None:
        """Update the turn, game status, and move list."""
        status = self.game.get_status()

        if status.is_game_over:
            if status.is_checkmate:
                message = f"Checkmate! {status.turn} has no legal move."
            elif status.is_stalemate:
                message = "Draw by stalemate."
            else:
                message = f"Game over: {status.termination}."
        elif status.is_check:
            message = f"{status.turn} is in check!"
        else:
            message = "Select a piece to see its legal moves."

        self.turn_label.setText(f"{status.turn} to move")
        self.status_label.setText(message)

        history = self.game.get_move_history()
        if not history:
            self.moves_label.setText("No moves yet")
        else:
            formatted = []
            for index in range(0, len(history), 2):
                white_move = history[index]
                black_move = (
                    history[index + 1]
                    if index + 1 < len(history)
                    else ""
                )
                formatted.append(
                    f"{index // 2 + 1}. {white_move}  {black_move}"
                )
            self.moves_label.setText("\n".join(formatted))

        self.board_widget.refresh()

    def start_new_game(self) -> None:
        """Reset the board and its displayed history."""
        self.game.new_game()
        self.board_widget.selected_square = None
        self.board_widget.legal_destinations.clear()
        self.board_widget.refresh()
        self.update_game_info()

    def undo_move(self) -> None:
        """Undo the most recent move."""
        self.game.undo_move()
        self.board_widget.selected_square = None
        self.board_widget.legal_destinations.clear()
        self.board_widget.refresh()
        self.update_game_info()
